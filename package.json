{
  "name": "kanken-5-6",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "漢字検定 6級・5級 学習アプリ（小学生用・完全オフライン）",
  "scripts": {
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:build": "node scripts/build-kanji-data.mjs",
    "data:verify": "node scripts/verify-kanji-data.mjs",
    "data:csv": "node scripts/export-csv.mjs",
    "data:all": "npm run data:fetch && npm run data:build && npm run data:verify && npm run data:csv",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test:logic": "node --experimental-strip-types --no-warnings scripts/test/logic-test.mts",
    "test:browser": "node scripts/test/browser-test.mjs",
    "test": "npm run test:logic && npm run test:tracing && npm run test:game && npm run test:exam && npm run build && npm run test:browser && npm run test:browser-tracing && npm run test:browser-writing && npm run test:browser-game && npm run test:browser-exam",
    "test:tracing": "node --experimental-strip-types --no-warnings scripts/test/tracing-test.mts",
    "test:browser-tracing": "node scripts/test/tracing-browser-test.mjs",
    "test:browser-writing": "node scripts/test/writing-browser-test.mjs",
    "test:game": "node --experimental-strip-types --no-warnings scripts/test/game-test.mts",
    "test:browser-game": "node scripts/test/game-browser-test.mjs",
    "shiba:sheet": "node scripts/test/shiba-sheet.mjs",
    "test:exam": "node --experimental-strip-types --no-warnings scripts/test/exam-test.mts",
    "test:browser-exam": "node scripts/test/exam-browser-test.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}